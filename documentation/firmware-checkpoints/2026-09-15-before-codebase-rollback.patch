+    if (!high) { droHeaderOnes = 0; return; }
+    if (++droHeaderOnes == DRO_HEADER_BITS) {
+      droCaptureFrame[0] = droCaptureFrame[1] = 0xFF;
+      for (byte i = 2; i < DRO_FRAME_BYTES; ++i) droCaptureFrame[i] = 0;
+      droCaptureBit = DRO_HEADER_BITS;
+    }
